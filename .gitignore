node_modules/
dist/
.DS_Store
*.log
.vite/
# Downloaded-at-build-time cloudflared binaries for packages/collab-server's
# compiled builds — fetched, not authored, so never committed.
vendor/
# packages/collab-server has no committed lockfile of its own (dependency
# locking for the whole monorepo is pnpm-lock.yaml at the root) — running
# `bun install`/`bun run` directly inside that package generates one
# locally that was never meant to be tracked.
packages/collab-server/bun.lock

# The embeddable viewer's build IS the distributable — it's what jsDelivr
# serves straight from this repo (see README "Embedding the viewer"), so
# unlike the editor/viewer apps' own dist/ (deployed separately, never
# committed), this one is checked in deliberately. Rebuild + recommit it
# after any change to packages/viewer-embed or packages/shared/src/
# viewerEngine.ts.
!packages/viewer-embed/dist/
!packages/viewer-embed/dist/**
