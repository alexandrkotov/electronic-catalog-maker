{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Real name to pick before first deploy — this is just a placeholder.
  "name": "ecm-collab-server",
  "main": "src/index.ts",
  // Bump to a current date before actually deploying (see README in this
  // package) — Cloudflare's compatibility-date list moves forward, and this
  // was picked conservatively (a date well in the past, guaranteed to
  // exist) rather than guessed at exactly "today".
  "compatibility_date": "2025-01-01",

  // Classic Durable Objects binding + migration syntax — the config format
  // for declaring a *new* SQLite-storage class in particular has been
  // evolving on Cloudflare's side; verify this block against
  // https://developers.cloudflare.com/durable-objects/ once a real account
  // exists to deploy against, rather than trusting this untested.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }
  ]
}
