{
  "id": "squarespace",
  "name": "Squarespace",
  "kind": "json-feed",
  "discover": {
    "path": "/sitemap.xml",
    "pattern": "<loc>https?://[^/<]+(/[^<]*?)/p/[^/<]+</loc>",
    "fallbackPattern": "<loc>https?://[^/<]+(/[^/<]+)/[^/<]+</loc>"
  },
  "detect": {
    "path": "{store}?format=json",
    "expectArray": "items"
  },
  "source": {
    "path": "{store}",
    "query": {
      "format": "json"
    },
    "cursor": {
      "param": "offset",
      "path": "pagination.nextPageOffset"
    },
    "itemsPath": "items",
    "only": {
      "path": "collection.typeName",
      "equals": "products"
    },
    "storeTitle": "collection.title",
    "maxPages": 100
  },
  "fields": {
    "name": "title",
    "sku": "structuredContent.variants[0].sku",
    "description": "excerpt",
    "folder": "categoryIds[0]",
    "image": "items[0].assetUrl",
    "imageFallback": "assetUrl"
  },
  "folderNames": {
    "path": "nestedCategories.categories[*]",
    "id": "id",
    "name": "displayName",
    "children": "children[*]",
    "fallback": "categories[0]"
  },
  "price": {
    "path": "structuredContent.variants[*].priceMoney.value",
    "mode": "range",
    "sale": {
      "flag": "structuredContent.variants[*].onSale",
      "path": "structuredContent.variants[*].salePriceMoney.value"
    }
  },
  "buyUrl": "{origin}{fullUrl}",
  "imageQuery": {
    "format": "1000w"
  },
  "clean": {
    "description": {
      "stripHtml": true,
      "maxLength": 600
    }
  }
}
