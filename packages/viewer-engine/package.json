{
  "name": "@ecm/viewer-engine",
  "version": "0.1.0",
  "private": true,
  "description": "The Electronic Catalog Maker viewer engine as a library: open a .ecatm catalog, show it with hotspots, and drive it from a host application.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/viewer-engine/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/viewer-engine/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/types/viewer-engine/src/server.d.ts",
      "import": "./dist/server.js"
    },
    "./style.css": "./dist/style.css",
    "./sql-wasm.wasm": "./dist/sql-wasm.wasm",
    "./fonts/DejaVuSans.ttf": "./dist/fonts/DejaVuSans.ttf",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.server.config.ts && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "pack": "pnpm pack"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.9",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@ecm/shared": "workspace:*",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
